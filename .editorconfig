# Installed by productforge-config's `update`. Generated: change it in productforge-config
# (andrew-organization/productforge-config), not here, or the next update writes it back.
# Written into every ProductForge repository by `productforge-config update`,
# from productforge-config's settings/editorconfig — change it there, not here.
# Editors that read EditorConfig save every file the way the shared
# end-of-file-fixer and trailing-whitespace hooks would leave it.
root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true
