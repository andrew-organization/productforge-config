# This repository's declaration of what it takes from productforge-config. Dotenv: read by make
# and by `update`. `common` is always taken and never named.
PF_KITS=python shell release
# Left out of the shared hooks: tests/fixture_* are the update command's test inputs, not this
# repository's own files, and the kits' makefiles are fragments that a repository's own Makefile
# includes, which checkmake, reading one file at a time, can't see whole.
PF_LINT_EXCLUDE=^tests/fixture_(repo|api|web)/|^kits/.*\.mk$
