[Unit]
Description=ProductForge runner host idle stop
After=productforge-runner-supervisor.service

[Service]
Type=oneshot
# Root, because stopping the host takes it; the supervisor, which runs as pf-runner, only writes the file this reads.
ExecStart=/usr/bin/python3 /opt/productforge-runner/idle_stop.py --idle-stop-minutes 15
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
