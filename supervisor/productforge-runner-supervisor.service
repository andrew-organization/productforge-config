[Unit]
Description=ProductForge ephemeral runner supervisor
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=pf-runner
ExecStart=/usr/bin/python3 /opt/productforge-runner/runner_supervisor.py run \
  --org YOUR-ORG --group YOUR-RUNNER-GROUP --labels pf \
  --token-file /etc/productforge-runner/token
Restart=always
RestartSec=10
# The supervisor itself gains no privilege, sees a private /tmp and writes only the Docker client's own
# configuration directory (when it exists). Its containers are started by the Docker daemon and are not
# bound by these settings; the supervisor confines them with the options on its `docker run`.
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=-/home/pf-runner/.docker
# Stopping removes the running container and then its registration, retrying a registration GitHub still
# holds as busy for under a minute; one still held after that is removed by the next start.
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
